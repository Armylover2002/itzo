<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payslip - {{employeeName}}</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        
        body {
            font-family: 'Inter', Arial, sans-serif;
            color: #1e293b;
            margin: 0;
            padding: 40px;
            background-color: #fff;
            font-size: 13px;
            line-height: 1.5;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .company-info h1 {
            margin: 0;
            font-size: 24px;
            color: #0f172a;
        }

        .company-info p {
            margin: 4px 0 0 0;
            color: #64748b;
        }

        .payslip-title {
            text-align: right;
        }

        .payslip-title h2 {
            margin: 0;
            font-size: 20px;
            color: #f97316; /* Orange brand color */
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .payslip-title p {
            margin: 4px 0 0 0;
            font-weight: 500;
            color: #475569;
        }

        .grid-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 15px;
        }

        .card-title {
            font-size: 14px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .details-table {
            width: 100%;
            border-collapse: collapse;
        }

        .details-table td {
            padding: 4px 0;
            vertical-align: top;
        }

        .details-table .label {
            color: #64748b;
            width: 40%;
        }

        .details-table .value {
            font-weight: 500;
            color: #0f172a;
        }

        .salary-breakdown {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        table.breakdown-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            overflow: hidden;
        }

        table.breakdown-table th {
            background-color: #f1f5f9;
            color: #334155;
            font-weight: 600;
            text-align: left;
            padding: 10px 15px;
            border-bottom: 1px solid #e2e8f0;
        }

        table.breakdown-table th.amount, table.breakdown-table td.amount {
            text-align: right;
        }

        table.breakdown-table td {
            padding: 10px 15px;
            border-bottom: 1px solid #e2e8f0;
            color: #475569;
        }

        table.breakdown-table tr:last-child td {
            border-bottom: none;
        }

        table.breakdown-table .total-row td {
            background-color: #f8fafc;
            font-weight: 600;
            color: #0f172a;
            border-top: 2px solid #e2e8f0;
        }

        .summary-section {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 30px;
        }

        .summary-flex {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .summary-item {
            text-align: center;
            flex: 1;
        }

        .summary-item .label {
            display: block;
            color: #64748b;
            margin-bottom: 5px;
            font-weight: 500;
        }

        .summary-item .value {
            font-size: 18px;
            font-weight: 700;
            color: #0f172a;
        }

        .summary-item.net-pay .value {
            font-size: 22px;
            color: #10b981; /* Emerald */
        }
        
        .footer {
            margin-top: 50px;
            border-top: 1px solid #e2e8f0;
            padding-top: 20px;
            font-size: 11px;
            color: #94a3b8;
            text-align: center;
        }

        .signatures {
            display: flex;
            justify-content: space-between;
            margin-top: 60px;
            padding: 0 40px;
        }

        .signature-box {
            text-align: center;
            width: 200px;
        }

        .signature-line {
            border-top: 1px solid #cbd5e1;
            margin-bottom: 10px;
        }
        
        .signature-box p {
            margin: 0;
            color: #475569;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="company-info">
            <h1>{{companyName}}</h1>
            <p>{{companyAddress}}</p>
        </div>
        <div class="payslip-title">
            <h2>PAYSLIP</h2>
            <p>{{monthName}} {{year}}</p>
        </div>
    </div>

    <div class="grid-container">
        <!-- Employee Details -->
        <div class="card">
            <div class="card-title">Employee Details</div>
            <table class="details-table">
                <tr><td class="label">Name:</td><td class="value">{{employeeName}}</td></tr>
                <tr><td class="label">Employee ID:</td><td class="value">{{employeeId}}</td></tr>
                <tr><td class="label">Designation:</td><td class="value">{{designation}}</td></tr>
                <tr><td class="label">Department:</td><td class="value">{{department}}</td></tr>
                <tr><td class="label">Joining Date:</td><td class="value">{{joiningDate}}</td></tr>
            </table>
        </div>

        <!-- Attendance & Bank Details -->
        <div class="card">
            <div class="card-title">Attendance & Bank Info</div>
            <table class="details-table">
                <tr><td class="label">Total Working Days:</td><td class="value">{{totalWorkingDays}}</td></tr>
                <tr><td class="label">Present Days:</td><td class="value">{{presentDays}}</td></tr>
                <tr><td class="label">LOP Days:</td><td class="value">{{lopDays}}</td></tr>
                <tr><td class="label">Bank Name:</td><td class="value">{{bankName}}</td></tr>
                <tr><td class="label">Account No:</td><td class="value">{{accountNumber}}</td></tr>
                <tr><td class="label">PAN:</td><td class="value">{{panNumber}}</td></tr>
            </table>
        </div>
    </div>

    <div class="salary-breakdown">
        <!-- Earnings -->
        <table class="breakdown-table">
            <thead>
                <tr>
                    <th>Earnings</th>
                    <th class="amount">Amount (₹)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Basic Salary</td>
                    <td class="amount">{{baseSalary}}</td>
                </tr>
                <tr>
                    <td>Overtime Bonus</td>
                    <td class="amount">{{overtimeBonus}}</td>
                </tr>
                <tr>
                    <td>Reimbursements</td>
                    <td class="amount">{{reimbursements}}</td>
                </tr>
                <!-- Empty rows for spacing to align with deductions -->
                <tr><td>&nbsp;</td><td></td></tr>
                <tr><td>&nbsp;</td><td></td></tr>
                
                <tr class="total-row">
                    <td>Gross Earnings</td>
                    <td class="amount">{{grossEarnings}}</td>
                </tr>
            </tbody>
        </table>

        <!-- Deductions -->
        <table class="breakdown-table">
            <thead>
                <tr>
                    <th>Deductions</th>
                    <th class="amount">Amount (₹)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>LOP Deduction</td>
                    <td class="amount">{{lopDeduction}}</td>
                </tr>
                <tr>
                    <td>Short Hours Deduction</td>
                    <td class="amount">{{shortHourDeduction}}</td>
                </tr>
                <tr>
                    <td>PF</td>
                    <td class="amount">0.00</td>
                </tr>
                <tr>
                    <td>ESI</td>
                    <td class="amount">0.00</td>
                </tr>
                <tr>
                    <td>Tax</td>
                    <td class="amount">0.00</td>
                </tr>
                
                <tr class="total-row">
                    <td>Total Deductions</td>
                    <td class="amount">{{totalDeductions}}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="summary-section">
        <div class="summary-flex">
            <div class="summary-item">
                <span class="label">Gross Earnings</span>
                <span class="value">₹{{grossEarnings}}</span>
            </div>
            <div class="summary-item">
                <span class="label">Total Deductions</span>
                <span class="value">₹{{totalDeductions}}</span>
            </div>
            <div class="summary-item net-pay">
                <span class="label">Net Pay</span>
                <span class="value">₹{{netSalary}}</span>
            </div>
        </div>
        <div style="text-align: center; margin-top: 15px; font-weight: 500; color: #475569;">
            Amount in words: {{amountInWords}}
        </div>
    </div>

    <div class="signatures">
        <div class="signature-box">
            <div class="signature-line"></div>
            <p>Employee Signature</p>
        </div>
        <div class="signature-box">
            <div class="signature-line"></div>
            <p>Authorised Signatory</p>
        </div>
    </div>

    <div class="footer">
        <p>This is a system generated document. Generated By: {{generatedBy}} on {{generatedDate}} (v{{payslipVersion}})</p>
    </div>

</body>
</html>
