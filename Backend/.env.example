# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES=30d

# Frontend URL (for CORS) — comma-separated list supported via CORS_ORIGIN
FRONTEND_URL=http://localhost:5173
# CORS_ORIGIN=http://localhost:5173,https://www.blazeapp.in,https://blazeapp.in


# Realtime & Queue Configuration
# Production Schedule Order: Redis + BullMQ are PRIMARY for T-15 activation.
# Mongo reconciler is fallback-only when jobs are missing/stuck.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
BULLMQ_ENABLED=false

# Rate limiting — window is in MINUTES via RATE_LIMIT_WINDOW only (a separate
# RATE_LIMIT_WINDOW_MS variable was removed; it never took effect when
# RATE_LIMIT_WINDOW was also set, so keeping both around was misleading).
RATE_LIMIT_WINDOW=15
# General/public per-IP API limiter (apiRateLimiter) — the shared baseline for every
# /api/* request, including all public bootstrap reads. Sized off measured frontend
# request volume: a cold Home-screen load fires ~13 requests, so 600/15min supports
# ~46 such loads per IP per 15 minutes (see config/env.js for the full rationale).
# Sensitive endpoints (login/OTP/maps) stack their own separate, stricter limiters on
# top of this one — raising this value does not weaken those.
RATE_LIMIT_MAX=600
# Per-IP ceiling on auth endpoints. Per-account lockout handles brute force.
AUTH_RATE_LIMIT_WINDOW=15
AUTH_RATE_LIMIT_MAX=50
# Failed verify attempts per phone/email; successful logins are not counted.
AUTH_VERIFY_RATE_LIMIT_MAX=10
# OTP sends per phone number (window in SECONDS). This is the SMS-spend control.
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW=600
MAPS_RATE_LIMIT_WINDOW=15
MAPS_RATE_LIMIT_MAX=60
BCRYPT_SALT_ROUNDS=10
UPLOAD_PATH=uploads/

# File storage (all uploads are stored on the server disk)
# Local: Backend/uploads. Live (NODE_ENV=production): /var/www/uploades.
UPLOAD_LOCAL_DIR=uploads
# Live: set to your API domain, e.g. https://api.itzofood.com (empty = http://localhost:PORT in dev)
UPLOAD_PUBLIC_BASE_URL=

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="Your App Name <noreply@yourdomain.com>"

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Admin registration safeguard
ADMIN_REGISTRATION_CODE=your_secure_admin_registration_code
ADMIN_NOTIFICATION_EMAILS=admin@example.com

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Password reset configuration
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Socket.io Configuration
SOCKET_CORS_ORIGIN=http://localhost:5173

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# Alternative: Raw JSON string for Firebase Service Account
FIREBASE_SERVICE_ACCOUNT={}
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com/

# SMS INDIA HUB CONFIGURATION
USE_DEFAULT_OTP=true
SMS_INDIA_HUB_USERNAME=your_username
SMS_INDIA_HUB_API_KEY=your_api_key
SMS_INDIA_HUB_SENDER_ID=your_sender_id
SMS_INDIA_HUB_DLT_TEMPLATE_ID=1007801291964877107

# OTP CONFIGURATION
OTP_EXPIRY_MINUTES=10
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT=300
OTP_RATE_WINDOW=600
OTP_EXPIRY=5m

# Admin login lockout (per-account, in addition to IP rate limits)
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
